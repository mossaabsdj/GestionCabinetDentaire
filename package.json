{
  "name": "cabinet-dentaire",
  "version": "4.0.2",
  "description": "Application de gestion pour cabinet dentaire.",
  "author": "Mossaab Saad Djaballahe",
  "private": true,
  "main": "main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "release": "electron-builder ",
    "start": "next start",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron": "electron main.js",
    "electron-build": "electron-builder --dir",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.mossaabsdj.cabinet-dentaire",
    "productName": "Cabinet_Dentaire",
    "files": [
      ".next/**",
      "main.js",
      "!**/@next/swc-*",
      "!**/@next/swc-darwin-arm64/**",
      "!**/@next/swc-darwin-x64/**",
      "!**/@next/swc-linux-x64-gnu/**",
      "!**/@next/swc-linux-arm64-gnu/**",
      "!**/@next/swc-linux-x64-musl/**",
      "!**/@next/swc-freebsd-x64/**",
      "preload.js",
      "app.js",
      "public/**",
      "server.js",
      "backup.js",
      "restore.js",
      "backup-crypto.js",
      "print-templates.js",
      "node_modules/**",
      "app/generated/prisma/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "public/",
        "to": "public"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asarUnpack": [
      "public",
      "app/generated/prisma",
      "node_modules/@prisma/engines"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cabinet Dentaire"
    },
    "publish": {
      "provider": "github",
      "owner": "mossaabsdj",
      "repo": "GestionCabinet",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "@heroui/react": "^2.8.4",
    "@heroui/theme": "^2.4.22",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.544.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.4",
    "sweetalert2": "^11.26.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/express": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "^4.1.13"
  }
}
